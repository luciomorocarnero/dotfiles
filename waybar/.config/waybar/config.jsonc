{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/soundcore_battery",
    "bluetooth",
    "custom/network_warp",
    "custom/check_mic",
    "pulseaudio",
    "idle_inhibitor",
    "battery",
    "clock"
  ],
  "hyprland/workspaces": {
    "format": "{name}"
  },
  "cpu": {
    "format": " {usage}%"
  },
  "memory": {
    "format": "󰍛 {}%"
  },
  "pulseaudio": {
    "format": " ",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "format": "{capacity}%",
    "states": {
      "warning": 30,
      "critical": 20
    },
    "events": {
      "on-discharging-warning": "notify-send -u critical 'Low Battery'"
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "{device_alias}",
    "tooltip-format": "{device_alias}"
  },
  "clock": {
    "timezone": "America/Argentina/Buenos_Aires",
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "idle_inhibitor": {
    "format": "{icon} ",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "custom/network_warp": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/net-logic.sh",
    "interval": 60,
    "on-click": "warp-cli connect && sleep 10 && pkill -RTMIN+9 waybar",
    "on-click-right": "warp-cli disconnect && pkill -RTMIN+9 waybar",
    "signal": 9,
    "tooltip": false
  },
  "custom/check_mic": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/check-mic.sh",
    "interval": "once",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && pkill -RTMIN+8 waybar",
    "on-click-right": "",
    "tooltip": false,
    "signal": 8
  },
  "custom/soundcore_battery": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/soundcore_battery.sh",
    "interval": 600,
    "on-click-right": "",
    "tooltip": false
  }
}
